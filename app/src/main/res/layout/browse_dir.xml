<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:card_view="http://schemas.android.com/apk/res-auto"
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/card_view"
    android:layout_width="match_parent"
    android:layout_height="@dimen/browse_dir_ll_height"
    android:layout_margin="@dimen/browse_dir_ll_margin"
    android:background="@drawable/browse_item_list_outline"
    >
<!--
android:elevation="@dimen/dv"
    wrap_content
card_view:cardCornerRadius="@dimen/radius"
    android:background="?android:attr/selectableItemBackground"
    -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="@dimen/browse_dir_ll_ll_min_height"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="@dimen/browse_dir_ll_ll_padding"
        >
<!--
android:background="#FCFCFC"
android:background="?android:attr/selectableItemBackground"
-->
       <RelativeLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" >

           <ImageView
               android:id="@+id/image1"
               android:layout_width="@dimen/browse_dir_ll_iv1_width"
               android:layout_height="@dimen/browse_dir_ll_iv1_height"

               android:layout_weight="0"
               android:src="@drawable/ic_my_filemanager_folder_002" />
<!--@drawable/glyphicons_145_folder_open-->

            <TextView
                android:id="@+id/count"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_alignParentLeft="true"
                android:text="123"
                android:gravity="center"
                android:textColor="@color/white"
                android:paddingLeft="@dimen/browse_dir_ll_tv1_padding_left"
                android:paddingRight="@dimen/browse_dir_ll_tv1_padding_right"
                android:background="@color/foobnix_light_blue_alfa"
                android:visibility="visible"
                android:textSize="@dimen/browse_dir_ll_tv1_text_size" />

           <ImageView
               android:id="@+id/imageCloud"
               android:visibility="gone"
               android:layout_alignParentBottom="true"
               android:layout_alignParentRight="true"
               android:layout_width="0dp"
               android:layout_height="0dp"
               android:layout_weight="0"
               android:paddingLeft="@dimen/browse_dir_ll_iv2_padding_left"
               android:paddingRight="@dimen/browse_dir_ll_iv2_padding_right"
               android:src="@drawable/glyphicons_761_sync" />
        </RelativeLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/browse_dir_ll_ll2_margin_left"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="vertical" >

            <TextView
                android:id="@+id/text1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:gravity="center_vertical"
                android:singleLine="true"
                android:text="Page"
                android:textSize="@dimen/browse_dir_ll_tv2_text_size"
                android:textStyle="bold" />
<!--16sp-->
            <TextView
                android:id="@+id/text2"
                android:layout_width="match_parent"
                android:layout_height="0px"
                android:ellipsize="end"
                android:gravity="center_vertical"
                android:singleLine="true"
                android:text="/path/"
                android:textSize="@dimen/browse_dir_ll_tv3_text_size"
                android:textStyle="normal" />
        </LinearLayout>
<!--wrap_content-->
        <TextView
            android:id="@+id/play"
            android:layout_width="0px"
            android:layout_height="wrap_content"
            android:text="@string/play"
            android:layout_marginRight="@dimen/browse_dir_ll_tv4_margin_right"
            android:textSize="@dimen/browse_dir_ll_tv4_text_size" />
<!--wrap_content-->
        <ImageView
            android:id="@+id/starIcon"
            android:layout_width="@dimen/browse_dir_ll_iv3_width"
            android:layout_height="@dimen/browse_dir_ll_iv3_height"
            android:layout_marginRight="@dimen/browse_dir_ll_iv3_margin_right"
            android:layout_weight="0"
            android:background="?android:attr/selectableItemBackground"
            android:src="@drawable/glyphicons_50_star_empty"
            card_view:tint="@color/tint_gray" />
    </LinearLayout>

</LinearLayout>
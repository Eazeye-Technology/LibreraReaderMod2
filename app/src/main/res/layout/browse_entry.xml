<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:card_view="http://schemas.android.com/apk/res-auto"
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/card_view"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="8dp"
    card_view:background="@color/md_theme_surface_highContrast"
    card_view:strokeWidth="1dp"
    card_view:strokeColor="@color/md_theme_outlineVariant_highContrast" >

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="42dip"
        android:orientation="horizontal"
        android:padding="16dp" >

        <com.foobnix.pdf.info.view.ScaledImageView
            android:id="@+id/image"
            android:layout_width="42dip"
            android:layout_height="wrap_content"
            android:layout_margin="4dip"
            android:layout_weight="0"
            android:src="@drawable/glyphicons_145_folder_open" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:layout_marginLeft="12dp"
            android:layout_weight="1"
            android:orientation="vertical" >

            <TextView
                android:id="@+id/author"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="author"
                android:textAppearance="@style/TextAppearance.Material3.BodyLarge"/>

            <TextView
                android:id="@+id/title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="title"
                android:textAppearance="@style/TextAppearance.Material3.HeadlineMedium.Emphasized" />

            <TextView
                android:id="@+id/category"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="2"
                android:text="category"
                android:textColor="@color/md_theme_secondary_highContrast"
                android:textAppearance="@style/TextAppearance.Material3.BodySmall" />

            <HorizontalScrollView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:scrollbars="none" >

                <LinearLayout
                    android:id="@+id/downloadLinks"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal" >
                </LinearLayout>
            </HorizontalScrollView>

            <TextView
                android:id="@+id/content"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="2dp"
                android:ellipsize="end"
                android:maxLines="5"
                android:text="Content ...."
                android:textAppearance="@style/TextAppearance.Material3.BodyMedium"/>

            <RelativeLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" >

                <LinearLayout
                    android:id="@+id/links"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_toLeftOf="@+id/expand"
                    android:orientation="vertical" >
                </LinearLayout>

                <TextView
                    android:id="@+id/expand"
                    style="@style/textLink"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentRight="true"
                    android:gravity="right"
                    android:text="@string/more"
                    android:textAppearance="@style/TextAppearance.Material3.LabelSmall" />
            </RelativeLayout>
        </LinearLayout>

        <ImageView
            android:id="@+id/remove"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="center_vertical"
            android:background="?android:attr/selectableItemBackground"
            android:contentDescription="@string/remove"
            android:src="@drawable/glyphicons_599_menu_close"
            android:tint="@color/lt_grey_dima" />
    </LinearLayout>

</androidx.cardview.widget.CardView>
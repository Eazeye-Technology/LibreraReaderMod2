<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android" >
    <item
        android:state_pressed="true"
        >
        <shape>
            <solid
                android:color="#80CCCCCC"
                />
            <stroke
                android:width="3dp"
                android:color="#000000"
                />
            <corners
                android:radius="15dp"
                />
            <padding
                android:left="4dp"
                android:top="4dp"
                android:right="4dp"
                android:bottom="4dp"
                />
        </shape>
    </item>
